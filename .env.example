# ---------------------------------------------------------------
# NOVA environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ---------------------------------------------------------------

# Public site URL (used for absolute links, OAuth redirects, metadata).
# Local: http://localhost:3000   Production: your Vercel/custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Phase 7+) ---------------------------------------
# Public: safe for the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET: server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mailgun (Phase 11+) ---------------------------------------
# SECRET: server-only. Never prefix with NEXT_PUBLIC_.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
# Use https://api.eu.mailgun.net if your domain is in the EU region.
MAILGUN_API_URL=https://api.mailgun.net
