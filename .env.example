# ---------------------------------------------------------------
# NOVA environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# On Vercel, add these in Project Settings > Environment Variables.
# ---------------------------------------------------------------

# Public site URL (absolute links, metadata, sitemap, email links).
# Local: http://localhost:3000   Production: your Vercel or custom domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------
# Public: safe for the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET: server-only. Never prefix with NEXT_PUBLIC_. Used to create orders and newsletter signups.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (order confirmation emails) ------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Optional --------------------------------------------------
# Browse the bundled demo catalog when Supabase is not configured.
# Automatic in development; set to true only to try a production build without a database.
# Orders can never be placed in this mode.
NOVA_LOCAL_CATALOG=
